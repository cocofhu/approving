# 本地开发环境变量。复制为 .env 后按需修改:`cp .env.example .env`
# (./start.sh 首次运行会自动帮你复制)。docker-compose.yml 会读取这个文件。

# 后端监听端口,前端 dev server 默认也代理到这个端口。
APPROVING_PORT=8080

# 沙箱镜像(后端侧)。留空则用网关默认(config.local.yaml → universal-sandbox-cursor:local)。
# 填了值则作为“每次创建”的镜像覆盖随请求发给网关。
APPROVING_SANDBOX_IMAGE=

# Go 模块代理,默认已用国内 goproxy.cn(直连 proxy.golang.org 在国内经常超时)。
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

# ── 沙箱网关(本仓库 sandbox-gateway/) ───────────────────────────────────
# 后端使用的网关地址。默认由 compose 在本机 :8899 托管。
APPROVING_SANDBOX_GATEWAY_URL=http://127.0.0.1:8899
# 本地托管网关监听端口(host 网络,需与 APPROVING_PORT 错开)。
APPROVING_GATEWAY_PORT=8899
# 网关源码目录(单仓默认 ./sandbox-gateway)。
SANDBOX_GATEWAY_DIR=./sandbox-gateway
# 网关创建沙箱时使用的镜像。默认 universal-sandbox-cursor:local；
# ./start.sh 发现本地没有该镜像时会自动从 sandbox-gateway/sandbox 构建。
APPROVING_GATEWAY_SANDBOX_IMAGE=universal-sandbox-cursor:local

# 登录账号在 server/config.yaml 的 auth.users。
# ./start.sh 首次运行会从 server/config.example.yaml 生成该文件;
# 默认账号: admin / demo1234。
