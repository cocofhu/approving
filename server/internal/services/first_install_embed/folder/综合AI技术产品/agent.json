{
  "schemaVersion": 1,
  "acpBackend": "cursor",
  "mcp": [
    {
      "name": "artifact-store",
      "url": "${GRASP_ARTIFACT_URL}",
      "headers": {
        "Authorization": "Bearer ${GRASP_ARTIFACT_TOKEN}"
      }
    }
  ],
  "env": {
    "GIT_REPOS": "${vars.repos}"
  },
  "layout": {
    "configRoot": "/root/.cursor",
    "workspaceDir": "/root/workspace"
  },
  "name": "综合AI技术产品"
}
